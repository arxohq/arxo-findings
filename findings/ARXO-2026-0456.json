  "act": "UAX #14 revision 57 (Unicode 18.0.0)",
  "acts": [
    "Unicode Standard Annex #14, Unicode Line Breaking Algorithm, revision 57",
    "Unicode Standard Annex #29, Unicode Text Segmentation, revision 49"
  ],
  "location": "Section 5.1, class AL",
  "text": {
    "en": {
      "title": "UAX #14 rev. 57, Section 5.1 class AL: format characters listed as AL are Line_Break=NU in the data",
      "summary": "The class AL description lists U+0600..U+0604, U+06DD and U+110BD among the format characters of class AL. LineBreak.txt 18.0.0 gives them Line_Break=NU since Unicode 15.1 (UTC action item 176-A81), and the NU description does not mention them. The table was not updated; revision 55 has the same table.",
      "impact": "U+0061, U+0020 SPACE, U+002E FULL STOP, U+0600 ARABIC NUMBER SIGN, position 2: as NU (data) LB15c gives a break before the full stop; as AL (the table) LB15d gives none. Published implementations split between the two readings.",
      "correction": "Move the rows for U+0600..U+0604, U+06DD and U+110BD from the AL table to the NU description."
    }
  },
