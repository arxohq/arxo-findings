  "act": "UAX #14 revision 57 (Unicode 18.0.0)",
  "acts": [
    "Unicode Standard Annex #14, Unicode Line Breaking Algorithm, revision 57",
    "Unicode Standard Annex #29, Unicode Text Segmentation, revision 49"
  ],
  "location": "Section 5.1, class SY, against LB25",
  "text": {
    "en": {
      "title": "UAX #14 rev. 57, Section 5.1 SY: is “except in front of digits” limited to numbers?",
      "summary": "The SY description says there is a break opportunity after a solidus except in front of digits. LB25 keeps SY × NU only after digits, so after a letter a solidus followed by a number allows a break.",
      "impact": "U+0061 U+002F U+0031: a break after the solidus, before the number.",
      "correction": "Say “except before digits when the solidus is part of a number, as in 1/2 or 06/07/99”."
    }
  },
