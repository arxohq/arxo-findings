  "act": "UAX #14 revision 57 (Unicode 18.0.0)",
  "acts": [
    "Unicode Standard Annex #14, Unicode Line Breaking Algorithm, revision 57",
    "Unicode Standard Annex #29, Unicode Text Segmentation, revision 49"
  ],
  "location": "Section 5.1, class EX, against LB25",
  "text": {
    "en": {
      "title": "UAX #14 rev. 57, Section 5.1 EX: should the exception list for EX include PR?",
      "summary": "The EX description says these characters behave like closing characters except in relation to PO and NS. LB25 keeps CL and CP before PR in numeric context but not EX, so EX also differs in relation to PR.",
      "impact": "U+0031 U+0021 U+002B U+0032 breaks after the exclamation mark; U+0031 U+0029 U+002B U+0032 does not.",
      "correction": "Add PR to the exception list of EX, or state that LB25 treats EX differently from CL."
    }
  },
