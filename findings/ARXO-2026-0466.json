  "act": "UAX #14 revision 57 (Unicode 18.0.0)",
  "acts": [
    "Unicode Standard Annex #14, Unicode Line Breaking Algorithm, revision 57",
    "Unicode Standard Annex #29, Unicode Text Segmentation, revision 49"
  ],
  "location": "Section 5.1, class GL",
  "text": {
    "en": {
      "title": "UAX #14 rev. 57, Section 5.1 GL: should the description name the HY and HH exceptions of LB12a?",
      "summary": "The GL description names SP and ZW as what can override the no-break prohibition. LB12a also allows a break before GL after HY and HH, which the HH description explains as widespread practice.",
      "impact": "U+0061, U+002D HYPHEN-MINUS, U+00A0 NO-BREAK SPACE, U+0062: a break after the hyphen, which the GL description does not mention.",
      "correction": "Mention the HY and HH exceptions of LB12a in the GL description."
    }
  },
  "status": {
    "badge": "reported",
    "label": {
      "en": "Reported",
      "ru": "Сообщено"
    },
    "conclusion": "confirmed",
