  "act": "UAX #29 revision 49 (Unicode 18.0.0)",
  "acts": [
    "Unicode Standard Annex #14, Unicode Line Breaking Algorithm, revision 57",
    "Unicode Standard Annex #29, Unicode Text Segmentation, revision 49"
  ],
  "location": "Section 4.2.1, against Table 3",
  "text": {
    "en": {
      "title": "UAX #29 rev. 49, Section 4.2.1: should the text note that U+058A is ALetter and U+30A0 is Katakana by default?",
      "summary": "Section 4.2.1 says hyphens are better kept out of the default word definition and names U+058A ARMENIAN HYPHEN and U+30A0 KATAKANA-HIRAGANA DOUBLE HYPHEN. Table 3 puts U+058A in ALetter and U+30A0 in Katakana, so by default they do not break words between letters of those classes.",
      "impact": "Armenian letters around U+058A and Katakana letters around U+30A0 form one word by default.",
      "correction": "Note in Section 4.2.1 that U+058A is ALetter and U+30A0 is Katakana in the default rules."
    }
  },
