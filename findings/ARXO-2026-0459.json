  "act": "UAX #29 revision 49 (Unicode 18.0.0)",
  "acts": [
    "Unicode Standard Annex #14, Unicode Line Breaking Algorithm, revision 57",
    "Unicode Standard Annex #29, Unicode Text Segmentation, revision 49"
  ],
  "location": "Section 4.2.6, against Table 3",
  "text": {
    "en": {
      "title": "UAX #29 rev. 49, Section 4.2.6: modifier symbols are said not to be ALetter, but 58 of them are",
      "summary": "Section 4.2.6 says that modifier symbols (General_Category Sk) are not in the ALetter class and so cause word breaks by default. WordBreakProperty.txt 18.0.0 gives Word_Break=ALetter to 58 Sk code points, and Table 3 of the same annex lists them by name in the ALetter row.",
      "impact": "U+0061, U+02D2 MODIFIER LETTER CENTRED RIGHT HALF RING, U+0062: the sentence gives breaks on both sides of U+02D2; the data and WB5 give one word.",
      "correction": "Say “Most modifier symbols (General_Category = Sk) are not in the ALetter class”."
    }
  },
