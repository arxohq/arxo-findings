  "acts": [
    "Unicode Standard Annex #14, Unicode Line Breaking Algorithm, revision 57",
    "Unicode Standard Annex #29, Unicode Text Segmentation, revision 49"
  ],
  "location": "Section 4.3, Basic Name Validation set",
  "text": {
    "en": {
      "title": "UAX #29 rev. 49, Section 4.3: how is the union and intersection in the Basic Name Validation set grouped?",
      "summary": "The set “[ \\p{name=/COMMA/}\\p{name=/FULL STOP/}&\\p{p} …” mixes union and intersection without brackets. UTS #18 does not fix one precedence and recommends brackets.",
      "impact": "U+236A APL FUNCTIONAL SYMBOL COMMA BAR (So) is in the set under one grouping and out of it under the other.",
      "correction": "Add brackets, for example [[\\p{name=/COMMA/}\\p{name=/FULL STOP/}]&\\p{p}]."
    }
  },
