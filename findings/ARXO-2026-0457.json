  "act": "UAX #14 revision 57 (Unicode 18.0.0)",
  "acts": [
    "Unicode Standard Annex #14, Unicode Line Breaking Algorithm, revision 57",
    "Unicode Standard Annex #29, Unicode Text Segmentation, revision 49"
  ],
  "location": "Section 10, Table 4",
  "text": {
    "en": {
      "title": "UAX #14 rev. 57, Section 10 Table 4: rows LB12a and LB12b do not match Section 6 or the test rules",
      "summary": "Table 4 numbers the test rules “LB12a | 12.0 | GL ×” and “LB12b | 12.1 | [^SP, BA, HY] × GL”. Section 6 has no rule LB12b: it has LB12, “GL ×”, and LB12a, “[^SP HY HH] × GL”, and the Modifications section records that Unicode 18.0 removed BA from LB12a. Both rows are one rule name off, and the formula of row 12.1 predates both recent changes of LB12a.",
      "impact": "U+2013 EN DASH (BA in 18.0), U+00A0 NO-BREAK SPACE, U+0061, position 1: LB12a and LineBreakTest.txt give no break; the formula of Table 4 allows a break.",
      "correction": "Read “LB12 | 12.0 | GL ×” and “LB12a | 12.1 | [^SP HY HH] × GL” in Table 4."
    }
  },
