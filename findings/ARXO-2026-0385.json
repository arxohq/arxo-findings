  "text": {
    "en": {
      "title": "Basel Framework: MAR21.33 and MAR21.38(2) bucket references",
      "summary": "MAR21.33 and MAR21.38 cite MAR21.53 (the CSR risk-weight table) for bucket definitions, which are in MAR21.51.",
      "impact": "Position: CSR index sensitivity, 80% IG sovereigns Reading a: bucket definitions in MAR21.53 Table 4: only bucket numbers and weights, no sector/credit quality definition to test '75% mapped to a sector bucket' Reading b: bucket definitions in MAR21.51 Table 3: bucket 1 IG sovereigns, RW 0.5% Difference: reference does not lead to the criterion",
      "correction": "Clarify or correct the cited passage so that the rule and its references give one result for the stated case."
    }
  },
